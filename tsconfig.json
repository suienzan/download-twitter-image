{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "types": ["chrome"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "noImplicitAny": true,
    "resolveJsonModule": true
  },
  "include": ["**/*"]
}
